        "max": 30.0,
        "nullable": true
      },
      {
        "name": "lux",
        "unit": "lx",
        "min": 0.0,
        "max": 130000.0,
        "nullable": true
      },
      {
        "name": "speed_kmh",
        "unit": "km/h",
        "min": 0.0,
        "max": 250.0,
        "nullable": true
      }
