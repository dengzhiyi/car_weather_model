          60.0
        ],
        "rh_pct": [
          0.0,
          100.0
        ],
        "p_sta_hpa": [
          800.0,
          1080.0
        ],
        "rain_mm": [
          0.0,
          30.0
        ],
        "lux": [
          0.0,
          130000.0
        ],
        "speed_kmh": [
          0.0,
          250.0
        ]
      }
    }
  },
  "decision": {
    "stayHoursDefault": 12.0,
    "floodHorizonH": 48,
    "fishingHorizonH": 48,
    "oi": {
      "weightMin": 0.4,
      "weightMax": 0.75,
      "qcPenalty": 0.12
    }
  },
  "thresholds": {
    "defaults": {
      "1h": 12.0,
      "3h": 24.0,
      "6h": 34.0,
      "24h": 64.0
    },
    "floors": {
      "1h": 8.0,
      "3h": 15.0,
      "6h": 20.0,
      "24h": 40.0
    },
    "percentiles": {
      "1h": 0.98,
      "3h": 0.98,
      "6h": 0.98,
      "24h": 0.95
    },
    "archiveDays": 365,
    "sourceValues": [
      "archive-era5",
      "default"
    ]
  },
  "utci": {
    "domain": {
      "tdb": [
        -50.0,
        50.0
      ],
      "dtr": [
        -30.0,
        70.0
      ],
      "v10": [
        0.5,
        17.0
      ],
      "rh": [
        0.0,
        100.0
      ]
    }
  },
  "output": {
    "stages": [
      "pre_departure",
      "post_arrival"
    ],
    "keys": [
      "meta",
      "flood",
      "camping",
      "fishing",
      "actions"
