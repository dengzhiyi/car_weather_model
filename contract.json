{
  "schemaVersion": "1.0.0",
  "timezone": {
    "internal": "UTC",
    "display": "+08:00",
    "sensorLog": "+08:00"
  },
  "endpoints": {
    "forecast": "https://api.open-meteo.com/v1/forecast",
    "archive": "https://archive-api.open-meteo.com/v1/archive",
    "elevation": "https://api.open-meteo.com/v1/elevation"
  },
  "hourly": {
    "request": {
      "pastDays": 1,
      "forecastDays": 3,
      "cellSelection": "nearest"
    },
    "fields": [
      {
        "name": "temperature_2m",
        "unit": "°C",
        "min": -60.0,
        "max": 60.0,
        "nullable": true
      },
      {
        "name": "relative_humidity_2m",
        "unit": "%",
        "min": 0.0,
        "max": 100.0,
        "nullable": true
      },
      {
        "name": "dew_point_2m",
        "unit": "°C",
        "min": -90.0,
        "max": 60.0,
        "nullable": true
      },
      {
        "name": "precipitation",
        "unit": "mm",
        "min": 0.0,
        "max": 500.0,
        "nullable": true
      },
      {
        "name": "precipitation_probability",
        "unit": "%",
        "min": 0.0,
        "max": 100.0,
        "nullable": true
      },
      {
        "name": "pressure_msl",
        "unit": "hPa",
        "min": 800.0,
        "max": 1100.0,
        "nullable": true
      },
      {
        "name": "surface_pressure",
        "unit": "hPa",
        "min": 500.0,
        "max": 1100.0,
        "nullable": true
      },
      {
        "name": "wind_speed_10m",
        "unit": "m/s",
        "min": 0.0,
        "max": 120.0,
        "nullable": true
      },
      {
        "name": "wind_gusts_10m",
        "unit": "m/s",
        "min": 0.0,
        "max": 150.0,
        "nullable": true
      },
      {
        "name": "wind_direction_10m",
        "unit": "°",
        "min": 0.0,
        "max": 360.0,
        "nullable": true
      },
      {
        "name": "cloud_cover",
        "unit": "%",
        "min": 0.0,
        "max": 100.0,
        "nullable": true
      },
      {
        "name": "shortwave_radiation",
        "unit": "W/m²",
        "min": 0.0,
        "max": 1500.0,
        "nullable": true
      },
      {
        "name": "uv_index",
        "unit": "1",
        "min": 0.0,
        "max": 20.0,
        "nullable": true
      },
      {
        "name": "cape",
        "unit": "J/kg",
        "min": 0.0,
        "max": 10000.0,
        "nullable": true
      },
      {
        "name": "soil_moisture_0_to_1cm",
        "unit": "m³/m³",
        "min": 0.0,
        "max": 1.0,
        "nullable": true
      },
      {
        "name": "visibility",
        "unit": "m",
        "min": 0.0,
        "max": 100000.0,
        "nullable": true
      }
    ]
  },
  "sensor": {
    "columns": [
      {
        "name": "time",
        "unit": "ISO8601 +08:00",
        "min": null,
        "max": null,
        "nullable": true
      },
      {
        "name": "mode",
        "unit": "parked|driving|empty",
        "min": null,
        "max": null,
        "nullable": true
      },
      {
        "name": "t_c",
        "unit": "°C",
        "min": -40.0,
        "max": 60.0,
